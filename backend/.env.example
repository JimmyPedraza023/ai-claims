DATABASE_URL=
# Carpeta del almacenamiento local de archivos (en la nube se reemplaza por Supabase Storage)
STORAGE_DIR= 

IP_HASH_SECRET=

# Clave secreta de Cloudflare Turnstile. Obligatoria en producción; sin ella el captcha queda desactivado.
# Para desarrollo usa la clave de prueba que siempre aprueba: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

CORS_ORIGINS=

# --- Worker y modelo de IA ---
NVIDIA_API_KEY=
LLM_MODEL=moonshotai/kimi-k3
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=3000
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
JOB_TIMEOUT_MS=150000
JOB_LEASE_SECONDS=210