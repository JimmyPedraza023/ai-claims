server {
  listen 80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  server_tokens off;
  client_max_body_size 110m;   # 10 archivos de 10 MB + campos

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header Referrer-Policy "no-referrer" always;

  location /api/ {
    proxy_pass http://api:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # no $proxy_add_x_forwarded_for: evita que falseen la IP
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # Vigilancia del reloj (GitHub Actions): POST /internal/clock-watch.
  # No se quita el prefijo: el backend lo sirve en /internal/...
  location /internal/ {
    proxy_pass http://api:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # Health checks para monitoreo externo (UptimeRobot, ALB, etc.) y el workflow.
  location = /health { proxy_pass http://api:3000/health; }
  location = /health/ready { proxy_pass http://api:3000/health/ready; }

  location /assets/ { root /usr/share/nginx/html; expires 1y; }
  location = /index.html { root /usr/share/nginx/html; expires -1; }
  location / {
    root /usr/share/nginx/html;
    try_files $uri /index.html;   # rutas de React Router
  }
}